# 1. Telegram Settings
# Get this from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Your numerical Telegram User ID (keeps the bot strictly private)
TELEGRAM_ALLOWED_USER_ID=your_numeric_id_here

# 2. Intelligence
# Options: 'gemini', 'anthropic', 'openai', 'github'
LLM_PROVIDER=gemini

# Google Gemini (Recommended - Generous Free Tier)
# Get from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI GPT-4o-mini
# Get from https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# GitHub Models (Free GPT-4o-mini)
# Get a Personal Access Token (classic) from GitHub Settings
GITHUB_TOKEN=your_github_token_here

# 3. Database (Firebase)
# Path to your Firebase service account JSON file (for local dev)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# OR base64 encode it for Render deployed environment variables:
# FIREBASE_SERVICE_ACCOUNT_BASE64=your_base64_string_here

# 4. Security
# Create a random secret string. The cron service (e.g. cron-job.org) 
# must hit /run-daily-check?key=THIS_SECRET to trigger the daily restock.
CRON_SECRET=super_secret_cron_key_123

# (Auto-populated by Render, do not set locally)
# RENDER_EXTERNAL_URL=https://your-app-name.onrender.com
